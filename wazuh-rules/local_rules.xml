<!-- Local rules -->
<!-- Custom detection rules for SOC Detection Lab -->
<!-- Author: Sanika Mahamulkar -->
<!-- Note: command-execution monitoring rules use type="pcre2" on <match> - -->
<!-- Wazuh's default match mode does not treat . and * as regex wildcards, -->
<!-- which was the root cause of an earlier documented limitation (see -->
<!-- detection-notes.md). Fixed and confirmed working below. -->

<group name="local,soc_lab,">

  <!-- T1136.001 / T1098 - Persistence via account creation or /etc/passwd tampering -->
  <rule id="100110" level="12">
    <if_group>syscheck</if_group>
    <match>/etc/passwd</match>
    <description>CRITICAL: /etc/passwd was modified - possible unauthorized account creation or persistence attempt (T1136.001 / T1098).</description>
    <mitre>
      <id>T1136.001</id>
      <id>T1098</id>
    </mitre>
    <group>attack,persistence,mitre_attack,</group>
  </rule>

  <!-- T1003 - Credential Access via /etc/shadow tampering -->
  <rule id="100111" level="13">
    <if_group>syscheck</if_group>
    <match>/etc/shadow</match>
    <description>CRITICAL: /etc/shadow was modified - possible credential tampering or access attempt (T1003).</description>
    <mitre>
      <id>T1003.008</id>
    </mitre>
    <group>attack,credential_access,mitre_attack,</group>
  </rule>

  <!-- T1548.003 - Privilege Escalation via sudoers tampering -->
  <rule id="100112" level="13">
    <if_group>syscheck</if_group>
    <match>/etc/sudoers</match>
    <description>CRITICAL: /etc/sudoers was modified - possible privilege escalation attempt (T1548.003).</description>
    <mitre>
      <id>T1548.003</id>
    </mitre>
    <group>attack,privilege_escalation,mitre_attack,</group>
  </rule>

  <!-- T1098.004 - Persistence via SSH authorized_keys tampering -->
  <rule id="100113" level="12">
    <if_group>syscheck</if_group>
    <match>authorized_keys</match>
    <description>CRITICAL: SSH authorized_keys file was modified - possible unauthorized SSH access persistence (T1098.004).</description>
    <mitre>
      <id>T1098.004</id>
    </mitre>
    <group>attack,persistence,mitre_attack,</group>
  </rule>

  <!-- T1087.001 - Account Discovery via command logging -->
  <rule id="100120" level="7">
    <match type="pcre2">CMDLOG.*cmd=cat /etc/passwd</match>
    <description>Possible local account enumeration detected (T1087.001 - Account Discovery).</description>
    <mitre>
      <id>T1087.001</id>
    </mitre>
    <group>attack,discovery,mitre_attack,</group>
  </rule>

  <!-- T1082 - System Information Discovery via command logging -->
  <rule id="100121" level="5">
    <match type="pcre2">CMDLOG.*cmd=(uname -a|cat /etc/os-release|hostnamectl)</match>
    <description>Possible system information discovery detected (T1082).</description>
    <mitre>
      <id>T1082</id>
    </mitre>
    <group>attack,discovery,mitre_attack,</group>
  </rule>

  <!-- T1069.001 - Permission Groups Discovery via command logging -->
  <rule id="100122" level="6">
    <match type="pcre2">CMDLOG.*cmd=(cat /etc/sudoers|sudo -l|getent group sudo)</match>
    <description>Possible permission/group enumeration detected (T1069.001 - Permission Groups Discovery).</description>
    <mitre>
      <id>T1069.001</id>
    </mitre>
    <group>attack,discovery,mitre_attack,</group>
  </rule>

</group>
